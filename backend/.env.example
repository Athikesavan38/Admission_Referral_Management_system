PORT=5000
MONGO_URI=mongodb://localhost:27017/admission-referral-portal
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
CLIENT_ORIGIN=http://localhost:5173

# Email (Gmail with App Password)
# 1. Enable 2-Step Verification at myaccount.google.com → Security
# 2. Generate App Password at myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Admin seed accounts (JSON array — loaded on startup)
# Each object must have: name, email, password
SEED_ADMINS=[{"name":"Admin User","email":"admin@example.com","password":"SecureP@ss1"}]

# ── SMS Configuration ──────────────────────────────────────────────────────────
# Provider: vonage | fast2sms
SMS_PROVIDER=vonage

# Vonage (sign up at dashboard.nexmo.com)
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_FROM=CIET

# Fast2SMS (India — fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key
